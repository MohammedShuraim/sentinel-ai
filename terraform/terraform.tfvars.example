# Copy to terraform.tfvars (gitignored) and adjust for your environment.
# SAFE EXAMPLE VALUES ONLY — never put real secrets, API keys, or passwords here.

project_name = "sentellent"
environment  = "dev"
aws_region   = "ap-south-1"

instance_type = "t3.micro"
key_pair_name = "sentellent-dev-keypair" # must already exist in the AWS account

# Database (identifiers only — passwords via Secrets Manager / TF_VAR later)
db_name              = "sentellent"
db_username          = "sentellent_admin"
db_engine_version    = "16.4"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20

tags = {
  Owner = "platform-team"
  CostCenter = "engineering"
}
