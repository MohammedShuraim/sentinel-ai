# Copy to terraform.tfvars (gitignored) and adjust for your environment.
# SAFE EXAMPLE VALUES ONLY — never put real secrets, API keys, or passwords here.

project_name = "sentellent"
environment  = "dev"
aws_region   = "ap-south-1"

instance_type = "t3.micro"
# Existing key pair in ap-south-1 — Terraform does not create it.
key_pair_name = "sentellent-key"

# Networking
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
public_subnet_az   = "ap-south-1a"
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
private_subnet_azs   = ["ap-south-1a", "ap-south-1b"]
# Replace with your public IP /32 before enabling SSH on real instances.
# Documentation TEST-NET example — not a real open-world allowlist.
ssh_ingress_cidr = "203.0.113.10/32"

# Database (identifiers only — NEVER put a real password here)
# Supply the master password at plan/apply time, e.g.:
#   $env:TF_VAR_db_password = "your-strong-password"   # PowerShell
#   export TF_VAR_db_password='your-strong-password'  # bash
# Or leave unset to auto-generate (value stored in Terraform state only).
db_name                  = "sentellent"
db_username              = "sentellent_admin"
db_engine_version        = "16"
db_instance_class        = "db.t4g.micro" # Free Tier eligible (prefer over larger classes)
db_allocated_storage     = 20
db_max_allocated_storage = 20 # equal to allocated → no storage autoscaling (Free Tier safe)
db_storage_type          = "gp3"
# Free Tier accounts in this project allow max 1 day of automated backup retention.
# Raise (e.g. to 7) only after Free Tier backup limits no longer apply.
db_backup_retention_period = 1
db_multi_az                = false # Multi-AZ is not Free Tier eligible
db_deletion_protection     = false
db_skip_final_snapshot     = true

tags = {
  Owner      = "platform-team"
  CostCenter = "engineering"
}
