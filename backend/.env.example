# ---------------------------------------------------------------------------
# Sentellent backend — example environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Database (local: localhost; docker-compose overrides host to `postgres`)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/sentellent
POSTGRES_DB=sentellent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# URL-encoded password (used by docker-compose for the container network URL)
POSTGRES_PASSWORD_URLENCODED=CHANGE_ME

# Auth / JWT (variable name is SECRET_KEY — there is no JWT_SECRET)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Market data providers (optional — app degrades gracefully without them)
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1

# AI providers (multi-provider with failover: primary -> fallback)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=groq

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# CORS / frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
