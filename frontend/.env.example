# ---------------------------------------------------------------------------
# Sentellent frontend — example environment configuration
# Copy to `.env.local` for local overrides. NEVER commit real secrets.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# ---------------------------------------------------------------------------

# Backend API URL reachable from the user's browser (not a Docker service name)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
